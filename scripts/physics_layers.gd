extends RefCounted
## 물리 충돌 레이어 규약. 이 프로젝트의 모든 스크립트/배치 코드가 여기를 따른다.
##
## 왜 나누는가:
##   소나무 숲에서는 플레이어 바로 아래를 나뭇가지가 지나간다. "지면까지의 높이"를
##   재는 레이가 그 가지를 지면으로 착각하면 활공 진입 판정(glide_min_height)이
##   막혀 핵심 기능이 죽는다. 그래서 '밟을 수 있는 것' 과 '지면' 을 층으로 구분한다.
##
##   레이어 1  플레이어 (PLAYER)
##             플레이어 캐릭터 본체. 카메라 스프링암은 이 층을 무시한다.
##   레이어 2  지형 (TERRAIN)
##             지면·바위·절벽 등 땅에 해당하는 것. **높이 판정 레이의 유일한 대상.**
##   레이어 3  나무 (TREE)
##             소나무 기둥(`기둥_*`)·가지(`가지_NN`). 밟고 설 수 있고 카메라도 밀어내지만
##             '지면' 이 아니므로 높이 판정에 걸리지 않는다.
##
## 새 오브젝트를 월드에 배치할 때:
##   - 땅으로 취급할 것    → TERRAIN
##   - 나무/구조물         → TREE
##   - 충돌 자체가 없는 것 → 이름을 "노충돌" 로 시작 (world.gd 가 충돌을 안 만든다)

const PLAYER := 1 << 0     ## 레이어 1
const TERRAIN := 1 << 1    ## 레이어 2
const TREE := 1 << 2       ## 레이어 3

## 캐릭터가 부딪히고 카메라가 밀려나는 대상 전체 (플레이어 자신은 제외)
const SOLID := TERRAIN | TREE


## 블렌더 오브젝트 이름으로 소속 레이어를 정한다.
## 모델러와의 명명 계약: 기둥 메시 = "기둥_" 시작, 가지 메시 = "가지_NN".
static func layer_for_name(mesh_name: String) -> int:
	if mesh_name.begins_with("기둥_") or mesh_name.begins_with("가지_"):
		return TREE
	return TERRAIN
